# ==========================================================================
# MISTERDOU ? variables d'environnement (copier vers .env / apps/*/.env.local)
# NE JAMAIS committer .env ? cette exemple est fournie ? titre de documentation
# ==========================================================================

# --------------------------------------------------------------------------
# Base de donn?es (PostgreSQL)
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://mdou:mdou_dev_password@localhost:5433/misterdou?schema=public

# --------------------------------------------------------------------------
# API
# --------------------------------------------------------------------------
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Origine(s) autoris?es pour CORS (s?par?es par des virgules)
WEB_ORIGIN=http://localhost:3000
# Secret cookies/sessions (min 32 octets) ? g?n?rer: openssl rand -hex 32
COOKIE_SECRET=change-me-32-bytes-minimum-random-hex-string
# Dur?e de vie session client (en secondes) ; session admin = 2h (fix? serveur)
SESSION_TTL_SECONDS=2592000
# Cl? ma?tresse de chiffrement des donn?es sensibles (AES-256-GCM, hex 64)
STORAGE_MASTER_KEY=change-me-64-chars-hex-random-string

# --------------------------------------------------------------------------
# Application web (Next.js)
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --------------------------------------------------------------------------
# PayTech (paiements ? ? remplir par l'administrateur, sandbox en dev)
# --------------------------------------------------------------------------
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_WEBHOOK_SECRET=
PAYTECH_SANDBOX=true
PAYTECH_BASE_URL=https://paytech.sn
PAYTECH_CALLBACK_URL=http://localhost:4000/api/v1/payments/callback
PAYTECH_WEBHOOK_PATH=/api/v1/webhooks/paytech

# --------------------------------------------------------------------------
# Google OAuth (connexion Google ? ? remplir dans la console Google)
# --------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --------------------------------------------------------------------------
# Admin bootstrap (script: pnpm admin:bootstrap)
# --------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_FIRST_NAME=Administrateur
ADMIN_BOOTSTRAP_PASSWORD=change-this-long-random-password
# L'accès complet exige une application TOTP après la première connexion.
ADMIN_SESSION_TTL_SECONDS=7200
ADMIN_SETUP_SESSION_TTL_SECONDS=600

# --------------------------------------------------------------------------
# Cloudflare R2 — stockage des fichiers (vide = disque local, développement)
# 1. Créer 2 buckets : un PRIVÉ (pièces d'identité) et un PUBLIC (images/vidéos).
# 2. Bucket privé : laisser l'accès public DÉSACTIVÉ. Les fichiers y sont déjà
#    chiffrés AES-256-GCM par l'API ; seule l'API les lit.
# 3. Bucket public : activer un domaine personnalisé (ex. media.misterdou.sn)
#    et le mettre dans R2_PUBLIC_BASE_URL. Règle CORS à ajouter :
#    [{"AllowedOrigins":["https://misterdou.sn"],"AllowedMethods":["PUT"],
#      "AllowedHeaders":["content-type"],"MaxAgeSeconds":3600}]
# 4. Jeton API R2 « Object Read & Write » limité à ces 2 buckets.
# En production, l'API refuse de démarrer sans R2_PRIVATE_BUCKET.
# --------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=misterdou-kyc
R2_PUBLIC_BUCKET=misterdou-media
R2_PUBLIC_BASE_URL=https://media.misterdou.sn
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_VIDEO_MB=60

# --------------------------------------------------------------------------
# Notifications par e-mail (SMTP réel — laisser vide = mode journalisation seule)
# --------------------------------------------------------------------------
SMTP_URL=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=MISTERDOU <no-reply@misterdou.sn>

# --------------------------------------------------------------------------
# Docker Postgres (docker-compose.yml)
# --------------------------------------------------------------------------
POSTGRES_USER=mdou
POSTGRES_PASSWORD=mdou_dev_password
POSTGRES_DB=misterdou
