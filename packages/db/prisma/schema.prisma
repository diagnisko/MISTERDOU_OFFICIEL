// Discussion d'un client à propos d'un compte en vente (un fil par client et
// par compte). Côté vente, répondent le vendeur du compte, les managers
// (permission SUPPORT) et l'administrateur ; le client ne voit jamais qui.
model ProductThread {
  id               String           @id @default(uuid())
  productId        String
  clientId         String
  lastMessageAt    DateTime         @default(now())
  clientLastReadAt DateTime?
  sellerLastReadAt DateTime?
  teamLastReadAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  client           User             @relation("ProductThreadClient", fields: [clientId], references: [id], onDelete: Cascade)
  messages         ProductMessage[]

  @@unique([productId, clientId])
  @@index([clientId, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
}

model ProductMessage {
  id         String        @id @default(uuid())
  threadId   String
  authorId   String
  fromClient Boolean
  content    String
  createdAt  DateTime      @default(now())
  thread     ProductThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author     User          @relation("ProductMessageAuthor", fields: [authorId], references: [id])

  @@index([threadId, createdAt])
}
