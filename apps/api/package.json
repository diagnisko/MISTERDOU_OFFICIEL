{
  "name": "@misterdou/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "admin:bootstrap": "tsx src/admin-bootstrap.ts",
    "admin:reset": "tsx src/admin-reset.ts",
    "legacy:import": "tsx src/legacy/run.ts",
    "legacy:repair": "tsx src/legacy/repair.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@misterdou/db": "workspace:*",
    "@misterdou/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "nodemailer": "^7.0.9",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
